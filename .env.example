# Required in Vercel Project Settings -> Environment Variables
VITE_SUPABASE_URL=https://ytlzepxlwpzeirccwsov.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Some older generated files read this name. Keep it equal to VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Vercel/Supabase marketplace integrations may provide these names.
# They are server-side at build time; vite.config.ts exposes only the safe public values.
SUPABASE_URL=https://ytlzepxlwpzeirccwsov.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional, only if you deploy a separate API service later
VITE_API_BASE_URL=
VITE_CLOUDINARY_CLOUD_NAME=
