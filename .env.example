# Required in Vercel Project Settings -> Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Some older generated files read this name. Keep it equal to VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Vercel/Supabase marketplace integrations may provide these names.
# They are server-side at build time; vite.config.ts exposes only the safe public values.
SUPABASE_URL=https://ytlzepxlwpzeirccwsov.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional, only if you deploy a separate non-Vercel API service later
VITE_APP_URL=
VITE_API_BASE_URL=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_LOCATIONIQ_TOKEN=

# Optional Supabase Edge Function secrets for approval emails
# Set these in Supabase Function secrets, not in browser-visible Vercel env vars.
RESEND_API_KEY=
EMAIL_FROM=Mohalla <no-reply@your-domain.com>
APP_URL=https://your-app-domain.com

# Optional Sentry browser monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1

# Optional Sentry source map upload during production builds
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
